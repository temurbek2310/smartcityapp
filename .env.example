# Two different 2GIS credentials. Keep them different: anything named
# NEXT_PUBLIC_* is inlined into the JavaScript every visitor downloads.

# 2GIS MapGL JS — client-exposed rendering key (browser-visible by design,
# same as a Google Maps browser key). Used only to draw maps in the browser.
# Get one at https://dev.2gis.com/.
NEXT_PUBLIC_MAPGL_API_KEY=your-2gis-mapgl-api-key

# 2GIS Routing API — a separate, paid product, called server-side only from
# src/app/api/directions/route.ts. Never prefix this with NEXT_PUBLIC_, and
# never reuse the MapGL key here: a routing key equal to the public key is
# effectively public too (the server logs a warning if they match).
# Must be a key with the Routing product enabled. Supply a distinct one
# before any live routing test; without it /api/directions answers
# { status: 'unavailable', reason: 'config' } and calls nobody.
# (Replaces the old MAPGL_ROUTING_API_KEY, which is no longer read.)
DGIS_ROUTING_API_KEY=your-2gis-routing-api-key
