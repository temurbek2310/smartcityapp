# 2GIS MapGL JS — client-exposed rendering key (browser-visible by design,
# same as a Google Maps browser key). Get one at https://dev.2gis.com/.
NEXT_PUBLIC_MAPGL_API_KEY=your-2gis-mapgl-api-key

# 2GIS Routing API — a separate product from MapGL JS, called server-side only
# from src/app/api/directions/route.ts. May need its own key/subscription
# even if you already have a MapGL key.
MAPGL_ROUTING_API_KEY=your-2gis-routing-api-key
